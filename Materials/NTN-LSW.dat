material elastic [
  name = moving-block
  rho = 1.148e-9    # tonne/mm^3
  E   = 7662        # MPa
  nu  = 0.20
]

material elastic [
  name = stationary-block
  rho = 1.148e-9    # tonne/mm^3
  E   = 7662        # MPa
  nu  = 0.20
]

friction linear_slip_weakening no_regularisation [
  mu_s = 0.8
  mu_k = 0.6
  d_c  = 5.5
]